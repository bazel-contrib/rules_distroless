    target_name = "libboost1.83-dev",
    urls = ["https://deb.debian.org/debian/pool/main/b/boost1.83/libboost1.83-dev_1.83.0-4.2_amd64.deb"],
)

deb_import(
    name = "boost_arm64",
    package_name = "libboost1.83-dev",
    sha256 = "0f82bfbd6d1afae0d03da64e4e2ac531effcf66e89e962a4fb6bebf0ec35db6e",
    target_name = "libboost1.83-dev",
